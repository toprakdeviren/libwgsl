overload pack2x16unorm ARG_VEC2F_1 U32 const,must_use NONE
overload pack2x16float ARG_VEC2F_1 U32 const,must_use NONE
overload unpack4x8snorm ARG_U32_1 VEC4F const,must_use NONE
overload unpack4x8unorm ARG_U32_1 VEC4F const,must_use NONE
overload unpack4xI8 ARG_U32_1 VEC4I const,must_use NONE
overload unpack4xU8 ARG_U32_1 VEC4U const,must_use NONE
overload unpack2x16snorm ARG_U32_1 VEC2F const,must_use NONE
