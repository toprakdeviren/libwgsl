		# §17.8 Atomic.
		overload atomicLoad ATOMIC_LOAD ARG0 - NONE
overload atomicAdd ATOMIC_RMW ARG0 - NONE
overload atomicSub ATOMIC_RMW ARG0 - NONE
overload atomicMax ATOMIC_RMW ARG0 - NONE
overload atomicMin ATOMIC_RMW ARG0 - NONE
overload atomicAnd ATOMIC_RMW ARG0 - NONE
overload atomicOr ATOMIC_RMW ARG0 - NONE
overload atomicXor ATOMIC_RMW ARG0 - NONE
overload atomicExchange ATOMIC_RMW ARG0 - NONE
overload atomicStore ATOMIC_STORE VOID - NONE
	overload atomicCompareExchangeWeak ATOMIC_CX ATOMIC_CX_RESULT - NONE

