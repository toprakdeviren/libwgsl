# WGSL §17 builtin metadata used by src/check/exprs.c.
# Single source of truth → tools/gen-wgsl-builtins.py → builtins.gen.h
#
# Format:
#   builtin <name> <return> <family> <arity> <flags> <special>
#   texture_matrix
#   overload <name> <pattern> <return> <flags> <special>   # optional override
#
# <return>  is a BR_* enum suffix.
# <family>  is a PF_* enum suffix.  Non-NONE entries use the generic
#           T-pattern overload resolver over the leading <arity> args.
# <flags>   is comma-separated: const,must_use.  Use '-' for no flags.
# <special> is a BS_* enum suffix for hand-written mixed-shape validators.
#
# kBuiltinOverloads is auto-derived from builtin rows via NAME_PATTERN in
# the generator (name → exact §17 matcher).  Write an `overload` line only
# to override that mapping or to add an extra pattern for the same name.
# Texture signatures expand from `texture_matrix` into kTextureOverloads.

# §17.2 Bit reinterpretation.
builtin bitcast TEMPLATE NONE 0 const,must_use NONE

# §17.3 Logical.
builtin all BOOL NONE 0 const,must_use NONE
builtin any BOOL NONE 0 const,must_use NONE
builtin select ARG0 NUMERIC_T 2 const,must_use NONE

# §17.4 Array.
builtin arrayLength U32 NONE 0 must_use NONE

# §17.5 Numeric.
builtin abs ARG0 NUMERIC_T 1 const,must_use NONE
builtin ceil ARG0 FLOAT_T 1 const,must_use NONE
builtin cos ARG0 FLOAT_T 1 const,must_use NONE
builtin cosh ARG0 FLOAT_T 1 const,must_use NONE
builtin exp ARG0 FLOAT_T 1 const,must_use NONE
builtin exp2 ARG0 FLOAT_T 1 const,must_use NONE
builtin floor ARG0 FLOAT_T 1 const,must_use NONE
builtin fract ARG0 FLOAT_T 1 const,must_use NONE
builtin log ARG0 FLOAT_T 1 const,must_use NONE
builtin log2 ARG0 FLOAT_T 1 const,must_use NONE
builtin round ARG0 FLOAT_T 1 const,must_use NONE
builtin sin ARG0 FLOAT_T 1 const,must_use NONE
builtin sinh ARG0 FLOAT_T 1 const,must_use NONE
builtin sqrt ARG0 FLOAT_T 1 const,must_use NONE
builtin tan ARG0 FLOAT_T 1 const,must_use NONE
builtin tanh ARG0 FLOAT_T 1 const,must_use NONE
builtin asin ARG0 FLOAT_T 1 const,must_use NONE
builtin acos ARG0 FLOAT_T 1 const,must_use NONE
builtin atan ARG0 FLOAT_T 1 const,must_use NONE
builtin asinh ARG0 FLOAT_T 1 const,must_use NONE
builtin acosh ARG0 FLOAT_T 1 const,must_use NONE
builtin atanh ARG0 FLOAT_T 1 const,must_use NONE
builtin trunc ARG0 FLOAT_T 1 const,must_use NONE
builtin sign ARG0 NUMERIC_T 1 const,must_use NONE
builtin normalize ARG0 FLOAT_T 1 const,must_use NONE
builtin inverseSqrt ARG0 FLOAT_T 1 const,must_use NONE
builtin saturate ARG0 FLOAT_T 1 const,must_use NONE
builtin radians ARG0 FLOAT_T 1 const,must_use NONE
builtin degrees ARG0 FLOAT_T 1 const,must_use NONE
builtin quantizeToF16 ARG0 FLOAT_T 1 const,must_use NONE
builtin reverseBits ARG0 INTEGER_T 1 const,must_use NONE
builtin countOneBits ARG0 INTEGER_T 1 const,must_use NONE
builtin countLeadingZeros ARG0 INTEGER_T 1 const,must_use NONE
builtin countTrailingZeros ARG0 INTEGER_T 1 const,must_use NONE
builtin firstLeadingBit ARG0 INTEGER_T 1 const,must_use NONE
builtin firstTrailingBit ARG0 INTEGER_T 1 const,must_use NONE
builtin extractBits ARG0 INTEGER_T 1 const,must_use NONE
builtin insertBits ARG0 INTEGER_T 2 const,must_use NONE
builtin min ARG0 NUMERIC_T 2 const,must_use NONE
builtin max ARG0 NUMERIC_T 2 const,must_use NONE
builtin pow ARG0 FLOAT_T 2 const,must_use NONE
builtin atan2 ARG0 FLOAT_T 2 const,must_use NONE
builtin step ARG0 FLOAT_T 2 const,must_use NONE
builtin ldexp ARG0 FLOAT_T 1 const,must_use LDEXP
builtin modf MODF_RESULT FLOAT_T 1 const,must_use NONE
builtin frexp FREXP_RESULT FLOAT_T 1 const,must_use NONE
builtin clamp ARG0 NUMERIC_T 3 const,must_use NONE
builtin fma ARG0 FLOAT_T 3 const,must_use NONE
builtin mix ARG0 FLOAT_T 2 const,must_use MIX
builtin smoothstep ARG0 FLOAT_T 3 const,must_use NONE
builtin faceForward ARG0 FLOAT_T 3 const,must_use NONE
builtin reflect ARG0 FLOAT_T 2 const,must_use NONE
builtin refract ARG0 FLOAT_T 2 const,must_use NONE
builtin dot ARG0_ELEM NUMERIC_T 2 const,must_use NONE
builtin dot4U8Packed U32 NONE 0 const,must_use NONE
builtin dot4I8Packed ARG0_ELEM NONE 0 const,must_use NONE
builtin distance ARG0_ELEM FLOAT_T 2 const,must_use NONE
builtin length ARG0_ELEM FLOAT_T 1 const,must_use NONE
builtin determinant ARG0_ELEM FLOAT_T 1 const,must_use NONE
builtin cross ARG0 FLOAT_T 2 const,must_use NONE
builtin transpose ARG0 FLOAT_T 1 const,must_use NONE

# §17.6 Derivatives.
builtin dpdx ARG0 FLOAT_T 1 must_use NONE
builtin dpdy ARG0 FLOAT_T 1 must_use NONE
builtin fwidth ARG0 FLOAT_T 1 must_use NONE
builtin dpdxCoarse ARG0 FLOAT_T 1 must_use NONE
builtin dpdyCoarse ARG0 FLOAT_T 1 must_use NONE
builtin fwidthCoarse ARG0 FLOAT_T 1 must_use NONE
builtin dpdxFine ARG0 FLOAT_T 1 must_use NONE
builtin dpdyFine ARG0 FLOAT_T 1 must_use NONE
builtin fwidthFine ARG0 FLOAT_T 1 must_use NONE

# §17.7 Texture.
builtin textureSample VEC4F NONE 0 must_use TEXTURE
builtin textureSampleLevel VEC4F NONE 0 must_use TEXTURE
builtin textureSampleBias VEC4F NONE 0 must_use TEXTURE
builtin textureSampleGrad VEC4F NONE 0 must_use TEXTURE
builtin textureSampleCompare VEC4F NONE 0 must_use TEXTURE
builtin textureSampleCompareLevel VEC4F NONE 0 must_use TEXTURE
builtin textureSampleBaseClampToEdge VEC4F NONE 0 must_use TEXTURE
builtin textureLoad VEC4F NONE 0 must_use TEXTURE
builtin textureStore VOID NONE 0 - TEXTURE
builtin textureGather VEC4F NONE 0 must_use TEXTURE
builtin textureGatherCompare VEC4F NONE 0 must_use TEXTURE
builtin textureDimensions U32 NONE 0 must_use TEXTURE
builtin textureNumLayers U32 NONE 0 must_use TEXTURE
builtin textureNumLevels U32 NONE 0 must_use TEXTURE
builtin textureNumSamples U32 NONE 0 must_use TEXTURE
texture_matrix

		# §17.8 Atomic.
		# CTS accepts discarding atomicLoad and atomicCompareExchangeWeak.
		# The RMW family (Add/Sub/Max/Min/And/Or/Xor/Exchange) returns the
		# previous value but discarding it is a common, valid pattern
		# (`atomicAdd(&counter, 1u)`). atomicStore is void.
		builtin atomicLoad ARG0_ELEM NONE 0 - NONE
builtin atomicAdd ARG0_ELEM NONE 0 - NONE
builtin atomicSub ARG0_ELEM NONE 0 - NONE
builtin atomicMax ARG0_ELEM NONE 0 - NONE
builtin atomicMin ARG0_ELEM NONE 0 - NONE
builtin atomicAnd ARG0_ELEM NONE 0 - NONE
builtin atomicOr ARG0_ELEM NONE 0 - NONE
builtin atomicXor ARG0_ELEM NONE 0 - NONE
builtin atomicExchange ARG0_ELEM NONE 0 - NONE
builtin atomicStore VOID NONE 0 - NONE
	builtin atomicCompareExchangeWeak ATOMIC_CX_RESULT NONE 0 - NONE

# §17.9–10 Pack / unpack.
builtin pack4x8snorm U32 NONE 0 const,must_use NONE
builtin pack4x8unorm U32 NONE 0 const,must_use NONE
builtin pack4xI8 U32 NONE 0 const,must_use NONE
builtin pack4xU8 U32 NONE 0 const,must_use NONE
builtin pack4xI8Clamp U32 NONE 0 const,must_use NONE
builtin pack4xU8Clamp U32 NONE 0 const,must_use NONE
builtin pack2x16snorm U32 NONE 0 const,must_use NONE
builtin pack2x16unorm U32 NONE 0 const,must_use NONE
builtin pack2x16float U32 NONE 0 const,must_use NONE
builtin unpack4x8snorm VEC4F NONE 0 const,must_use NONE
builtin unpack4x8unorm VEC4F NONE 0 const,must_use NONE
builtin unpack4xI8 VEC4I NONE 0 const,must_use NONE
builtin unpack4xU8 VEC4U NONE 0 const,must_use NONE
builtin unpack2x16snorm VEC2F NONE 0 const,must_use NONE
builtin unpack2x16unorm VEC2F NONE 0 const,must_use NONE
builtin unpack2x16float VEC2F NONE 0 const,must_use NONE

# §17.11 Synchronization.
builtin storageBarrier VOID NONE 0 - NONE
builtin textureBarrier VOID NONE 0 - NONE
builtin workgroupBarrier VOID NONE 0 - NONE
builtin workgroupUniformLoad ARG0_ELEM NONE 0 must_use NONE

