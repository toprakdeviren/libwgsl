overload pack4x8snorm ARG_VEC4F_1 U32 const,must_use NONE
overload pack4x8unorm ARG_VEC4F_1 U32 const,must_use NONE
overload pack4xI8 ARG_VEC4I_1 U32 const,must_use NONE
overload pack4xU8 ARG_VEC4U_1 U32 const,must_use NONE
