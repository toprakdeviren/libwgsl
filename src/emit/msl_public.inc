static void emit_node(M *m, const WGSLNode *n, int depth) {
    if (!n) return;
    switch (n->kind) {
    case WGSL_NODE_TRANSLATION_UNIT:
        m_puts(m, "// Generated by libwgsl §6.1 WGSL→MSL emitter\n");
        m_puts(m, "#include <metal_stdlib>\nusing namespace metal;\n\n");
        /* §B3b: collect module resources before walking so entry emit can
         * inject them as parameters (and we can skip invalid globals). */
        collect_module_resources(m, n);
        if (m->nresources > 0)
            m_puts(m, "// §B3b: module-scope resources → entry parameters "
                      "(not file-scope device/texture globals)\n\n");
        for (uint32_t i = 0; i < n->child_count; i++) {
            if (!n->children[i]) continue;
            emit_node(m, n->children[i], depth + 1);
            if (i + 1 < n->child_count) m_nl(m);
        }
        break;
    case WGSL_NODE_DIR_ENABLE:
    case WGSL_NODE_DIR_REQUIRES:
    case WGSL_NODE_DIR_DIAGNOSTIC:
        m_indent(m);
        m_puts(m, "/* ");
        m_span(m, n->span_offset, n->span_length);
        m_puts(m, " */\n");
        break;
    case WGSL_NODE_DECL_STRUCT:
        emit_struct(m, n, depth);
        break;
    case WGSL_NODE_DECL_FUNCTION:
        emit_fn(m, n, depth);
        break;
    case WGSL_NODE_DECL_ALIAS: {
        m_indent(m);
        m_puts(m, "typedef ");
        if (n->child_count > 0)
            emit_type_spec(m, n->children[n->child_count - 1], depth + 1);
        m_putc(m, ' ');
        uint32_t o = wgsl_node_name_span(n).offset;
        uint32_t l = wgsl_node_name_span(n).length;
        m_span(m, o, l);
        m_puts(m, ";\n");
        break;
    }
    case WGSL_NODE_DECL_CONST:
        emit_var_like(m, n, "constant", depth);
        break;
    case WGSL_NODE_DECL_VAR:
        /* §B3b: storage/uniform/workgroup/texture/sampler/private module
         * vars become entry params (or body thread locals) — never emit as
         * file-scope device globals (silent-invalid MSL). */
        if (module_var_is_resource(m, n)) {
            m_indent(m);
            m_puts(m, "/* §B3b resource '");
            m_span(m, wgsl_node_name_span(n).offset, wgsl_node_name_span(n).length);
            m_puts(m, "' → entry parameter / thread local */\n");
            break;
        }
        emit_var_like(m, n, NULL, depth);
        break;
    case WGSL_NODE_DECL_OVERRIDE:
        emit_var_like(m, n, "constant", depth);
        break;
    case WGSL_NODE_DECL_CONST_ASSERT:
        emit_stmt(m, n, depth);
        break;
    default:
        m_indent(m);
        m_puts(m, "/* ");
        m_span(m, n->span_offset, n->span_length);
        m_puts(m, " */\n");
        m_diag(m, WGSL_MSL_DIAG_UNSUPPORTED_STMT,
               n->span_offset, n->span_length,
               "top-level construct not emitted as MSL");
        break;
    }
}

/* Walk entry body for locals that shadow stage_in rewrite symbols. */
static void detect_shadowing(M *m, const WGSLNode *n,
                             const WGSLSymbol **syms, int nsym,
                             uint8_t *shadowed)
{
    if (!n || nsym <= 0) return;
    if (n->kind == WGSL_NODE_DECL_LET || n->kind == WGSL_NODE_DECL_VAR ||
        n->kind == WGSL_NODE_DECL_CONST || n->kind == WGSL_NODE_DECL_PARAM)
    {
        uint32_t off = wgsl_node_name_span(n).offset;
        uint32_t len = wgsl_node_name_span(n).length;
        for (int i = 0; i < nsym; i++) {
            if (!syms[i] || shadowed[i]) continue;
            if (syms[i]->name_len == len && m->src &&
                (size_t)off + len <= m->src_len &&
                memcmp(syms[i]->name, m->src + off, len) == 0)
            {
                shadowed[i] = 1;
                m_diag(m, WGSL_MSL_DIAG_SHADOWED_REWRITE, off, len,
                       "cannot safely rewrite stage_in param: shadowed by local");
            }
        }
    }
    for (uint32_t i = 0; i < n->child_count; i++)
        detect_shadowing(m, n->children[i], syms, nsym, shadowed);
}

/* Patch emit_entry_from_plan rewrite setup — call site updated below via
 * full function body already having rewrite setup; we inject shadowing
 * scan there. */

static WGSLMslEmit *msl_emit_from_ast(const WGSLNode *root, const char *src,
                                      size_t src_len, const WGSLResult *res)
{
    M m;
    memset(&m, 0, sizeof m);
    m.src = src;
    m.src_len = src_len;
    m.res = res;
    m.at_line_start = 1;
    if (root) emit_node(&m, root, 0);

    WGSLMslEmit *e = (WGSLMslEmit *)calloc(1, sizeof *e);
    if (!e) {
        free(m.buf);
        for (int i = 0; i < m.ndiags; i++) free((void *)m.diags[i].message);
        free(m.diags);
        return NULL;
    }
    if (m.oom) {
        free(m.buf);
        e->msl = (char *)malloc(1);
        if (e->msl) e->msl[0] = 0;
    } else {
        if (!m.buf) {
            m.buf = (char *)malloc(1);
            if (m.buf) m.buf[0] = 0;
        } else if (m.len == 0 || m.buf[m.len - 1] != '\n') {
            m_nl(&m);
        }
        e->msl = m.buf;
    }
    e->incomplete = m.incomplete;
    e->diags = m.diags;
    e->ndiags = m.ndiags;
    return e;
}

static char *msl_from_ast(const WGSLNode *root, const char *src, size_t src_len,
                          const WGSLResult *res)
{
    WGSLMslEmit *e = msl_emit_from_ast(root, src, src_len, res);
    if (!e) return NULL;
    char *out = e->msl;
    e->msl = NULL; /* steal */
    wgsl_msl_emit_free(e);
    return out;
}

WGSLMslEmit *wgsl_msl_emit_result(const WGSLResult *r) {
    if (!r || !r->ast.root || !r->src_copy) return NULL;
    return msl_emit_from_ast(r->ast.root, r->src_copy, r->src_len, r);
}

WGSLMslEmit *wgsl_msl_emit(const char *src) {
    return wgsl_msl_emit_n(src, src ? strlen(src) : 0);
}

WGSLMslEmit *wgsl_msl_emit_n(const char *src, size_t src_len) {
    WGSLResult *r = wgsl_check_n(src, src_len);
    if (!r) return NULL;
    WGSLMslEmit *e = NULL;
    if (r->ast.root)
        e = msl_emit_from_ast(r->ast.root, r->src_copy, r->src_len, r);
    else {
        e = (WGSLMslEmit *)calloc(1, sizeof *e);
        if (e) {
            e->msl = (char *)malloc(1);
            if (e->msl) e->msl[0] = 0;
        }
    }
    wgsl_free(r);
    return e;
}

void wgsl_msl_emit_free(WGSLMslEmit *e) {
    if (!e) return;
    free(e->msl);
    for (int i = 0; i < e->ndiags; i++)
        free((void *)e->diags[i].message);
    free(e->diags);
    free(e);
}

const char *wgsl_msl_emit_text(const WGSLMslEmit *e) {
    return e && e->msl ? e->msl : "";
}
int wgsl_msl_emit_ok(const WGSLMslEmit *e) {
    return e && !e->incomplete;
}
int wgsl_msl_emit_incomplete(const WGSLMslEmit *e) {
    return e ? e->incomplete : 1;
}
int wgsl_msl_emit_diag_count(const WGSLMslEmit *e) {
    return e ? e->ndiags : 0;
}
const WGSLMslDiag *wgsl_msl_emit_diag(const WGSLMslEmit *e, int index) {
    if (!e || index < 0 || index >= e->ndiags) return NULL;
    return &e->diags[index];
}

char *wgsl_to_msl_result(const WGSLResult *r) {
    if (!r || !r->ast.root || !r->src_copy) return NULL;
    return msl_from_ast(r->ast.root, r->src_copy, r->src_len, r);
}

char *wgsl_to_msl(const char *src) {
    return wgsl_to_msl_n(src, src ? strlen(src) : 0);
}

char *wgsl_to_msl_n(const char *src, size_t src_len) {
    WGSLResult *r = wgsl_check_n(src, src_len);
    if (!r) return NULL;
    char *out = NULL;
    if (r->ast.root)
        out = msl_from_ast(r->ast.root, r->src_copy, r->src_len, r);
    else {
        out = (char *)malloc(1);
        if (out) out[0] = 0;
    }
    wgsl_free(r);
    return out;
}
